# API root — include the /api (or /public/api) suffix.
#   local  : http://localhost:8000/api
#   shared : https://dev.dittomart.in/public/api
#   prod   : https://app.dittomart.in/public/api
VITE_API_BASE_URL=https://app.dittomart.in/public/api

# BARE domain (no scheme, no trailing slash). Must match brands.domain in the DB.
VITE_BRAND_DOMAIN=app.sriaadhya.in

VITE_PAYU_FORM_URL=https://secure.payu.in/_payment

# Optional — AddressPage falls back to /coordinate-to-address without it.
VITE_GOOGLE_MAPS_API_KEY=
